# Supabase (spec §4 — data/auth/storage)
NEXT_PUBLIC_SUPABASE_URL=https://irwpsewtevnzqzbsfchj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Hosts (spec §21/§45 — platform vs console vs future widget bootstrap)
PLATFORM_ROOT_DOMAIN=localhost
CONSOLE_SUBDOMAIN=app
PUBLIC_URL_SCHEME=http
PUBLIC_URL_PORT=3000

# AI Gateway (spec §5 — provider abstraction; Phase 3). Gemini is the initial
# provider; Anthropic is an optional second implementation behind the same
# AIProvider interface, used for the model router's fallback path.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
