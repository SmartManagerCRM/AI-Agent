# SmartManager AI Agent — environment variables.
#
# Copy this file to `.env.local` for local development, or set these as
# real environment variables in your hosting panel for production (see
# DEPLOYMENT.md). Never commit a filled-in copy of this file — `.env`,
# `.env.local`, and `.env.production` are all gitignored.

# ── Supabase (required) ──────────────────────────────────────────────────
# Create a project at https://supabase.com, then Project Settings → API
# for the URL and publishable key, and Project Settings → API → Service
# Role for the secret key. See DATABASE_SETUP.md for provisioning the
# schema itself (migrations, reference data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ── Hosts (required) ──────────────────────────────────────────────────────
# Three logical hosts share one Next.js server, told apart by the `Host`
# header (src/proxy.ts): the platform marketing site (root domain), the
# subscriber console (CONSOLE_SUBDOMAIN), and an optional dedicated Agent
# host (AGENT_SUBDOMAIN — only used once its DNS exists; Agent links are
# path-based, /agent/<slug>, unless AGENT_URL is set below).
# In production, set PLATFORM_ROOT_DOMAIN to your real domain and create
# the matching DNS records — see DEPLOYMENT.md.
PLATFORM_ROOT_DOMAIN=localhost
CONSOLE_SUBDOMAIN=app
AGENT_SUBDOMAIN=agent
PUBLIC_URL_SCHEME=http
# Omit PUBLIC_URL_PORT entirely in production (only needed for a
# non-default local dev port).
PUBLIC_URL_PORT=3000

# Optional escape hatch: if your host can't serve CONSOLE_SUBDOMAIN as a
# real subdomain (e.g. a shared-hosting plan without additional-subdomain
# support), set CONSOLE_URL to an origin that does resolve — typically the
# same root domain, with no subdomain — and every console/staff link uses
# that instead of building one from CONSOLE_SUBDOMAIN. Leave unset to keep
# the default subdomain-based console origin.
# CONSOLE_URL=https://yourdomain.com

# The customer-facing Agent is path-based on the platform host by default:
#   https://yourdomain.com/agent/<business-slug>
# (always resolvable — no extra DNS record needed). Set AGENT_URL ONLY after
# a dedicated Agent domain has a real, verified DNS record pointing at this
# app; every Agent link, QR code and widget then uses it instead:
# AGENT_URL=https://agent.yourdomain.com

# ── AI Gateway (optional — the app runs without these, AI features just
#    report "not configured" until added) ─────────────────────────────────
# Gemini is the primary, paid-tier provider; Anthropic is an optional
# second implementation used as the model router's fallback. Which
# specific model serves a "fast" vs "agent" request is configured in the
# `ai_model_configs` table via the console's Super Admin area, not here.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Google Places API (New) key for "Analyze from Google Maps" (optional).
# Server-side only; restrict it to the Places API (New) in Google Cloud Console.
GOOGLE_PLACES_API_KEY=

# ── Automatic translation (optional — no AI) ──────────────────────────────
# Names and descriptions owners and the Super Admin add are translated into
# the other languages in the background (src/server/translate), cheapest first:
# built-in word list → Azure free tier → DeepL Free → Azure paid tier →
# open-source models on this server. Each service is used only if its key is
# set, and never beyond its free monthly characters (counted in the database).
# Server-side only; never sent to the browser.
#
# Azure Translator resource on the free F0 tier (2,000,000 characters/month).
# The region is the resource's location (e.g. westeurope) — required for
# regional or multi-service resources.
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
# DeepL API Free key (ends in ":fx"; 500,000 characters/month).
DEEPL_API_KEY=
# A second Azure Translator resource on a paid tier (S1, billed per character),
# used only once both free allowances are used up. Leave empty for none.
# AZURE_TRANSLATOR_PAID_MONTHLY_LIMIT caps its characters per month (empty: no cap).
AZURE_TRANSLATOR_PAID_KEY=
AZURE_TRANSLATOR_PAID_REGION=
AZURE_TRANSLATOR_PAID_MONTHLY_LIMIT=

# ── Subscription payments — Paddle Billing (optional) ─────────────────────
# Subscribers pay their plan through Paddle, renewing automatically (see
# DEPLOYMENT.md "Subscription payments (Paddle)"). All three or none — without
# them the built-in test checkout is used. Sandbox keys start with pdl_sdbx_ /
# test_, live keys with pdl_live_ / live_. API key and webhook secret are
# server-side only; the client-side token is used by Paddle.js in the browser.
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
# Last resort: open-source models (OPUS-MT) run in a separate process on this
# server; they download once from Hugging Face and need far more memory than
# the app itself while translating. Set to "off" on a server too small for them.
# TRANSLATION_LOCAL_MODELS=off

# ── Multi-instance deployments only (optional) ────────────────────────────
# Only needed if you run more than one Node process for this app (this
# app's own Hostinger deployment does, per DEPLOYMENT.md's three-hostname
# setup). Next.js encrypts Server Function closures with a per-build key
# by default; running multiple instances built independently would use
# different keys and intermittently fail with "Failed to find Server
# Action". Generate one value with `openssl rand -base64 32` and set the
# SAME value on every instance — must be set before `next build` runs
# (baked into the build output, not read at request time).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ── Performance diagnostics (optional) ────────────────────────────────────
# `on` prints [PERF] timing lines (operation name, duration, row count —
# never values) for the proxy, auth/tenant resolution and the heaviest
# console queries. Leave unset/off in normal production operation.
# PERF_LOGGING=on

# ── Payment gateways: NOT configured here ─────────────────────────────────
# Moyasar and Tap credentials are per-tenant (each business connects its
# own merchant account) and are entered in the console's own Settings →
# Payment methods page after the business signs up — never as environment
# variables. See ARCHITECTURE_ASSESSMENT.md §22.
