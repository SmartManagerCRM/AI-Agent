# Supabase (spec §4 — data/auth/storage)
NEXT_PUBLIC_SUPABASE_URL=https://irwpsewtevnzqzbsfchj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Hosts (spec §21/§45 — platform vs console vs future widget bootstrap)
PLATFORM_ROOT_DOMAIN=localhost
CONSOLE_SUBDOMAIN=app
PUBLIC_URL_SCHEME=http
PUBLIC_URL_PORT=3000

# AI Gateway (spec §5 — provider abstraction; Phase 3). Gemini is the
# primary, PAID-TIER provider — add a paid Gemini API key here at deploy
# time (Hostinger), not a free-tier key. Anthropic is an optional second
# implementation behind the same AIProvider interface, used for the model
# router's fallback path if a Gemini call fails. Which specific model
# serves a "fast" vs "agent" request comes from the `ai_model_configs`
# table, not from an env var — see ARCHITECTURE_ASSESSMENT.md §10.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
