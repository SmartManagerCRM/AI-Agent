# SmartManager AI Agent — environment variables.
#
# Copy this file to `.env.local` for local development, or set these as
# real environment variables in your hosting panel for production (see
# DEPLOYMENT.md). Never commit a filled-in copy of this file — `.env`,
# `.env.local`, and `.env.production` are all gitignored.

# ── Supabase (required) ──────────────────────────────────────────────────
# Create a project at https://supabase.com, then Project Settings → API
# for the URL and publishable key, and Project Settings → API → Service
# Role for the secret key. See DATABASE_SETUP.md for provisioning the
# schema itself (migrations, reference data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ── Hosts (required) ──────────────────────────────────────────────────────
# Three logical hosts share one Next.js server, told apart by the `Host`
# header (src/proxy.ts): the platform marketing site (root domain), the
# subscriber console (CONSOLE_SUBDOMAIN), and the standalone/embeddable
# Agent (AGENT_SUBDOMAIN). Locally: app.localhost:3000, agent.localhost:3000.
# In production, set PLATFORM_ROOT_DOMAIN to your real domain and create
# the matching DNS records — see DEPLOYMENT.md.
PLATFORM_ROOT_DOMAIN=localhost
CONSOLE_SUBDOMAIN=app
AGENT_SUBDOMAIN=agent
PUBLIC_URL_SCHEME=http
# Omit PUBLIC_URL_PORT entirely in production (only needed for a
# non-default local dev port).
PUBLIC_URL_PORT=3000

# Optional escape hatch: if your host can't serve CONSOLE_SUBDOMAIN as a
# real subdomain (e.g. a shared-hosting plan without additional-subdomain
# support), set CONSOLE_URL to an origin that does resolve — typically the
# same root domain, with no subdomain — and every console/staff link uses
# that instead of building one from CONSOLE_SUBDOMAIN. Leave unset to keep
# the default subdomain-based console origin.
# CONSOLE_URL=https://yourdomain.com

# ── AI Gateway (optional — the app runs without these, AI features just
#    report "not configured" until added) ─────────────────────────────────
# Gemini is the primary, paid-tier provider; Anthropic is an optional
# second implementation used as the model router's fallback. Which
# specific model serves a "fast" vs "agent" request is configured in the
# `ai_model_configs` table via the console's Super Admin area, not here.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Multi-instance deployments only (optional) ────────────────────────────
# Only needed if you run more than one Node process for this app (this
# app's own Hostinger deployment does, per DEPLOYMENT.md's three-hostname
# setup). Next.js encrypts Server Function closures with a per-build key
# by default; running multiple instances built independently would use
# different keys and intermittently fail with "Failed to find Server
# Action". Generate one value with `openssl rand -base64 32` and set the
# SAME value on every instance — must be set before `next build` runs
# (baked into the build output, not read at request time).
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# ── Payment gateways: NOT configured here ─────────────────────────────────
# Moyasar and Tap credentials are per-tenant (each business connects its
# own merchant account) and are entered in the console's own Settings →
# Payment methods page after the business signs up — never as environment
# variables. See ARCHITECTURE_ASSESSMENT.md §22.
