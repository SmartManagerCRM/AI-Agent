{
  "name": "smartmanager-ai-agent",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "build:standalone": "next build --webpack && ([ -d public ] && cp -r public .next/standalone/ || true) && cp -r .next/static .next/standalone/.next/",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "npx --yes supabase@2.118.0 test db",
    "test:e2e": "playwright test",
    "db:start": "npx --yes supabase@2.118.0 start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor,realtime,postgres-meta",
    "db:reset": "npx --yes supabase@2.118.0 db reset",
    "db:types": "npx --yes supabase@2.118.0 gen types typescript --local > src/types/database.ts && prettier --write src/types/database.ts",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
